{
  "name": "frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --exclude src/core/simulation/balanceSim.test.ts",
    "test:watch": "vitest --exclude src/core/simulation/balanceSim.test.ts",
    "test:coverage": "vitest run --coverage --exclude src/core/simulation/balanceSim.test.ts",
    "test:balance": "vitest run src/core/simulation/balanceSim.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "balance:report": "tsx scripts/balanceReport.ts",
    "gen:api-types": "python3 ../backend/scripts/export_openapi.py && openapi-typescript ../backend/openapi.json -o src/types/api-generated.ts",
    "check:api-types": "npm run gen:api-types && git diff --exit-code -- ../backend/openapi.json src/types/api-generated.ts"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@sentry/react": "^10.75.0",
    "@tanstack/react-query": "^5.103.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^26.4.2",
    "i18next-http-backend": "^4.0.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.4",
    "tslib": "^2.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
