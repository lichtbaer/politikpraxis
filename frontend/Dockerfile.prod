# Frontend — Multi-Stage Build (Vite → nginx mit reiner SPA-Auslieferung)
FROM node:26-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

ARG VITE_API_URL=/api
ARG VITE_REGISTRATION_NUMBER
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_ENVIRONMENT
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_REGISTRATION_NUMBER=$VITE_REGISTRATION_NUMBER
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT

RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=5s \
  CMD ["wget", "--no-verbose", "--tries=1", "--spider", "http://localhost/"]

CMD ["nginx", "-g", "daemon off;"]
