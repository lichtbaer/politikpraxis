# Frontend — Multi-Stage Build (Vite → nginx mit reiner SPA-Auslieferung)
FROM node:26-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

ARG VITE_API_URL=/api
ARG VITE_REGISTRATION_NUMBER
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_REGISTRATION_NUMBER=$VITE_REGISTRATION_NUMBER

RUN npm run build

FROM nginx:alpine
# Alpine-Pakete aktualisieren — die nginx:alpine-Basis wird nicht immer mit den
# neuesten Paket-Patches gebaut (z. B. util-linux/libuuid-CVEs, von Trivy im
# Image-Scan gemeldet).
RUN apk update && apk upgrade --no-cache
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=5s \
  CMD ["wget", "--no-verbose", "--tries=1", "--spider", "http://localhost/"]

CMD ["nginx", "-g", "daemon off;"]
